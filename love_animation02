# ============================================================
# ANIMATION VARIABLES
# ============================================================

start_time = time.perf_counter()

GATHER_END = GATHER_TIME

HOLD_END = (
    GATHER_TIME
    + HOLD_TIME
)

CYCLE_TIME = (
    GATHER_TIME
    + HOLD_TIME
    + EXPLODE_TIME
)

last_cycle = -1


# ============================================================
# ANIMATION LOOP
# ============================================================

def animate():

    global last_cycle

    elapsed = (
        time.perf_counter()
        - start_time
    )

    # --------------------------------------------------------
    # CURRENT CYCLE
    # --------------------------------------------------------

    cycle = int(
        elapsed / CYCLE_TIME
    )

    if cycle != last_cycle:

        if last_cycle != -1:

            # Prepare every particle for
            # the next continuous cycle.

            for particle in particles:

                particle.prepare_next_cycle()

        last_cycle = cycle

    # --------------------------------------------------------
    # POSITION IN CURRENT CYCLE
    # --------------------------------------------------------

    t = elapsed % CYCLE_TIME

    # --------------------------------------------------------
    # GATHER
    # --------------------------------------------------------

    if t < GATHER_END:

        phase = "gather"

        progress = (
            t / GATHER_TIME
        )

        pulse = 1.0

    # --------------------------------------------------------
    # HOLD
    # --------------------------------------------------------

    elif t < HOLD_END:

        phase = "hold"

        hold_progress = (
            t - GATHER_TIME
        ) / HOLD_TIME

        progress = hold_progress

        # Two heartbeat pulses
        beat = math.sin(
            hold_progress
            * math.pi
            * 4
        )

        pulse = (
            1.0
            + 0.055 * beat
        )

    # --------------------------------------------------------
    # EXPLOSION
    # --------------------------------------------------------

    else:

        phase = "explode"

        progress = (
            t -
            - HOLD_END
        ) / EXPLODE_TIME

        pulse = 1.0

    # --------------------------------------------------------
    # UPDATE ALL PARTICLES
    # --------------------------------------------------------

    for particle in particles:

        particle.update(
            phase,
            progress,
            pulse
        )

    # --------------------------------------------------------
    # LOVE TEXT
    # --------------------------------------------------------

    if phase == "hold":

        text_pulse = int(
            42
            + 3 * math.sin(
                progress
                * math.pi
                * 4
            )
        )

        canvas.itemconfig(
            love_text,
            font=(
                "Arial",
                text_pulse,
                "bold"
            )
        )

    else:

        canvas.itemconfig(
            love_text,
            font=(
                "Arial",
                42,
                "bold"
            )
        )

    # --------------------------------------------------------
    # NEXT FRAME
    # --------------------------------------------------------

    root.after(
        int(1000 / FPS),
        animate
    )


# ============================================================
# START
# ============================================================

animate()

root.mainloop()
