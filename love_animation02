import tkinter as tk
import math
import random
import time


# ============================================================
# SETTINGS
# ============================================================

WIDTH = 1100
HEIGHT = 800

# Around 1700 particles
# This gives a dense heart without making the animation too slow.
PARTICLE_COUNT = 1700

HEART_X = 190
HEART_Y = 180

GATHER_TIME = 3.0
HOLD_TIME = 2.5
EXPLODE_TIME = 2.5

FPS = 60


# ============================================================
# WINDOW
# ============================================================

root = tk.Tk()

