# ============================================================
# MATHEMATICAL HEART
# ============================================================

def heart_equation(x, y):
    """
    Returns True when (x,y) is inside
    the mathematical heart.
    """

    return (
        (x * x + y * y - 1) ** 3
        - x * x * y ** 3
        <= 0
    )


# ============================================================
# FIND EXACT HEART BOUNDARY
# ============================================================

def heart_boundary(angle):
    """
    Finds the outer boundary of the heart
    along a particular angle.
    """

    low = 0.0
    high = 1.5

    cos_a = math.cos(angle)
    sin_a = math.sin(angle)

    # Binary search for the edge
    for _ in range(30):

        mid = (low + high) / 2

        x = mid * cos_a
        y = mid * sin_a

        if heart_equation(x, y):
            low = mid
        else:
            high = mid

    radius = low

    return (
        radius * cos_a,
        radius * sin_a
    )


# ============================================================
# CREATE HEART POINTS
# ============================================================

def create_heart_points():

    points = []

    # --------------------------------------------------------
    # FILLED HEART
    # --------------------------------------------------------

    spacing = 0.055

    y = -1.05
    row = 0

    while y <= 1.05:

        # Hexagonal particle arrangement
        offset = (
            spacing / 2
            if row % 2
            else 0
        )

        x = -1.2 + offset

        while x <= 1.2:

            if heart_equation(x, y):

                # Very small jitter makes it look organic
                # without disturbing the heart boundary.
                jx = random.uniform(
                    -0.008,
                    0.008
                )

                jy = random.uniform(
                    -0.008,
                    0.008
                )

                test_x = x + jx
                test_y = y + jy

                if heart_equation(
                    test_x,
                    test_y
                ):
                    x_final = test_x
                    y_final = test_y
                else:
                    x_final = x
                    y_final = y

                points.append(
                    (
                        x_final * HEART_X,
                        y_final * HEART_Y,
                        False
                    )
                )

            x += spacing

        y += spacing * 0.86
        row += 1

    # --------------------------------------------------------
    # PERFECT OUTLINE
    # --------------------------------------------------------

    outline_count = 380

    for i in range(outline_count):

        angle = (
            2 * math.pi
            * i
            / outline_count
        )

        x, y = heart_boundary(angle)

        points.append(
            (
                x * HEART_X,
                y * HEART_Y,
                True
            )
        )

    return points


heart_points = create_heart_points()


# ============================================================
# PARTICLE COLORS
# ============================================================

INNER_COLORS = [
    "#ff1744",
    "#ff2058",
    "#ff2d6d",
    "#ff4081",
    "#ff4f8f"
]

OUTLINE_COLORS = [
    "#ff6b9d",
    "#ff8ab5",
    "#ffb6ce",
    "#ffffff"
]


# ============================================================
# PARTICLE CLASS
# ============================================================

class Particle:

    def __init__(
        self,
        target_x,
        target_y,
        is_outline
    ):

        self.target_x = target_x
        self.target_y = target_y

        self.is_outline = is_outline

        # ----------------------------------------------------
        # RANDOM START POSITION
        # ----------------------------------------------------

        self.start_x = random.uniform(
            -WIDTH / 2,
            WIDTH / 2
        )

        self.start_y = random.uniform(
            -HEIGHT / 2,
            HEIGHT / 2
        )

        # ----------------------------------------------------
        # EXPLOSION POSITION
        # ----------------------------------------------------

        self.create_explosion_target()

        # ----------------------------------------------------
        # PARTICLE SIZE
        # ----------------------------------------------------

        if is_outline:

            self.size = random.uniform(
                2.5,
                4.5
            )

            self.color = random.choice(
                OUTLINE_COLORS
            )

        else:

            self.size = random.uniform(
                2.0,
                4.0
            )

            self.color = random.choice(
                INNER_COLORS
            )

        # ----------------------------------------------------
        # GLOW
        # ----------------------------------------------------

        self.glow_size = self.size * 2.8

        # Glow particle
        self.glow = canvas.create_oval(
            0,
            0,
            0,
            0,
            fill="#28000e",
            outline=""
        )

        # Main particle
        self.dot = canvas.create_oval(
            0,
            0,
            0,
            0,
            fill=self.color,
            outline=""
        )


    # ========================================================
    # EXPLOSION TARGET
    # ========================================================

    def create_explosion_target(self):

        angle = random.uniform(
            0,
            math.pi * 2
        )

        distance = random.uniform(
            350,
            650
        )

        self.explode_x = (
            math.cos(angle)
            * distance
        )

        self.explode_y = (
            math.sin(angle)
            * distance
        )


    # ========================================================
    # PREPARE NEXT CYCLE
    # ========================================================

    def prepare_next_cycle(self):

        # The place where the particle ended
        # becomes its new starting position.

        self.start_x = self.explode_x
        self.start_y = self.explode_y

        # New explosion direction
        self.create_explosion_target()


    # ========================================================
    # EASING
    # ========================================================

    @staticmethod
    def smoothstep(x):

        return (
            x * x * (3 - 2 * x)
        )


    # ========================================================
    # UPDATE PARTICLE
    # ========================================================

    def update(
        self,
        phase,
        progress,
        pulse
    ):

        # ----------------------------------------------------
        # GATHER
        # ----------------------------------------------------

        if phase == "gather":

            p = self.smoothstep(
                progress
            )

            # Swirling movement becomes zero
            # exactly when the particle reaches
            # the heart.

            swirl_strength = (
                (1 - p) * 70
            )

            swirl_angle = (
                self.target_x * 0.015
                + self.target_y * 0.01
                + p * math.pi * 10
            )

            swirl_x = (
                math.cos(swirl_angle)
                * swirl_strength
            )

            swirl_y = (
                math.sin(swirl_angle)
                * swirl_strength
            )

            x = (
                self.start_x
                + (
                    self.target_x
                    - self.start_x
                ) * p
                + swirl_x
            )

            y = (
                self.start_y
                + (
                    self.target_y
                    - self.start_y
                ) * p
                + swirl_y
            )

        # ----------------------------------------------------
        # HOLD / HEARTBEAT
        # ----------------------------------------------------

        elif phase == "hold":

            # EXACT heart position,
            # only scaled uniformly for heartbeat.

            x = (
                self.target_x
                * pulse
            )

            y = (
                self.target_y
                * pulse
            )

        # ----------------------------------------------------
        # EXPLODE
        # ----------------------------------------------------

        else:

            # Smooth explosion
            p = 1 - (
                1 - progress
            ) ** 3

            x = (
                self.target_x
                + (
                    self.explode_x
                    - self.target_x
                ) * p
            )

            y = (
                self.target_y
                + (
                    self.explode_y
                    - self.target_y
                ) * p
            )

        # ----------------------------------------------------
        # CONVERT TO CANVAS COORDINATES
        # ----------------------------------------------------

        screen_x = CENTER_X + x
        screen_y = CENTER_Y - y

        # ----------------------------------------------------
        # GLOW
        # ----------------------------------------------------

        glow = (
            self.glow_size
            * (
                0.8
                + 0.2 * pulse
            )
        )

        canvas.coords(
            self.glow,
            screen_x - glow,
            screen_y - glow,
            screen_x + glow,
            screen_y + glow
        )

        # ----------------------------------------------------
        # MAIN PARTICLE
        # ----------------------------------------------------

        s = self.size

        canvas.coords(
            self.dot,
            screen_x - s,
            screen_y - s,
            screen_x + s,
            screen_y + s
        )


# ============================================================
# CREATE PARTICLES
# ============================================================

particles = []

for x, y, is_outline in heart_points:

    particle = Particle(
        x,
        y,
        is_outline
    )

    particles.append(
        particle
    )


print(
    "Particles:",
    len(particles)
)


